\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Pair~1}---vessels 412000690 (blue) and 412325200 (orange), Chinese coast, 2013--2018, 102 days within 25\,km. Background = combined daily presence density (KDE, 0--1 scale). The model's top-ranked pair shows sustained co-presence in the Yellow Sea (${\sim }$121\textdegree E, 37--39\textdegree N), confirming the high link-prediction score corresponds to a real shared operating area.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:casestudy}{{1}{5}{\textbf {Pair~1}---vessels 412000690 (blue) and 412325200 (orange), Chinese coast, 2013--2018, 102 days within 25\,km. Background = combined daily presence density (KDE, 0--1 scale). The model's top-ranked pair shows sustained co-presence in the Yellow Sea (${\sim }$121\textdegree E, 37--39\textdegree N), confirming the high link-prediction score corresponds to a real shared operating area}{figure.1}{}}

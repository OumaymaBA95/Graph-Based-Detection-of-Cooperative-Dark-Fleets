\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Bubble chart of monthly close approaches (days within 25\,km) for all eight validated pairs, 2013--2019. Each row is one pair (sorted by total overlap, highest at top); bubble size $\propto $ days within 25\,km that month. Pair~1 (CHN, 84 days across 9 months) dominates with large, closely spaced bubbles in 2015--2016, indicating persistent co-presence. Most other pairs are sporadic. Pair~7 is the only cross-flag pair.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:overlap}{{3}{9}{Bubble chart of monthly close approaches (days within 25\,km) for all eight validated pairs, 2013--2019. Each row is one pair (sorted by total overlap, highest at top); bubble size $\propto $ days within 25\,km that month. Pair~1 (CHN, 84 days across 9 months) dominates with large, closely spaced bubbles in 2015--2016, indicating persistent co-presence. Most other pairs are sporadic. Pair~7 is the only cross-flag pair}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {(a)} Overview map of China showing the cluster region (red rectangle). \textbf  {(b)} Zoomed view of the East China Sea cluster. Faint gray dots show every recorded rendezvous point; colored markers highlight three cluster pairs (Pair~3, 4, 5---matching Figure~\ref {fig:overlap} numbering) involving six CHN-flagged vessels. The red X marks the weighted hotspot centroid (${\sim }$29.7\textdegree N, 122.3\textdegree E), roughly 50--80\,km offshore from Ningbo. Three independent pairs (six vessels) converge repeatedly on the same offshore area, suggesting a shared operating region rather than coincidence.}}{9}{figure.4}\protected@file@percent }
\newlabel{fig:cluster}{{4}{9}{\textbf {(a)} Overview map of China showing the cluster region (red rectangle). \textbf {(b)} Zoomed view of the East China Sea cluster. Faint gray dots show every recorded rendezvous point; colored markers highlight three cluster pairs (Pair~3, 4, 5---matching Figure~\ref {fig:overlap} numbering) involving six CHN-flagged vessels. The red X marks the weighted hotspot centroid (${\sim }$29.7\textdegree N, 122.3\textdegree E), roughly 50--80\,km offshore from Ningbo. Three independent pairs (six vessels) converge repeatedly on the same offshore area, suggesting a shared operating region rather than coincidence}{figure.4}{}}
